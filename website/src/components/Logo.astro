---
interface Props {
  height?: number;
  showVersion?: boolean;
  href?: string;
}
const base = import.meta.env.BASE_URL;
const { height = 15, showVersion = true, href = base } = Astro.props;
// The wordmark ships with the app; its own aspect is 369 × 102.
const wordmark = `${base.replace(/\/$/, '')}/logo/asterism-wordmark.svg`;
---
<a class="brand" href={href}>
  <img
    class="wordmark"
    src={wordmark}
    alt="ASTERISM"
    style={`height:${height}px;width:${(height * 369.28 / 102.3).toFixed(1)}px;display:block;`}
  />
  {showVersion && <span class="version">v0.2.0</span>}
</a>

<style>
  .brand { display: flex; align-items: center; gap: 10px; }
</style>
