---
import Logo from './Logo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;
const repo = 'https://github.com/EpilepsyCenter/asterism';
---
<footer class="site-foot"><div class="wrap">
  <div class="foot">
    <div>
      <Logo height={14} showVersion={false} />
      <p class="desc">Scientific graphing and statistics for labs, on your own machine.</p>
      <div style="margin-top:14px;"><span class="led">Free for noncommercial use</span></div>
    </div>
    <div>
      <h5>Product</h5>
      <ul>
        <li><a href={link('/features')}>Features</a></li>
        <li><a href={link('/workflow')}>Workflow</a></li>
        <li><a href={`${repo}/releases`}>Releases</a></li>
        <li><a href={`${repo}/blob/main/README.md`}>README</a></li>
      </ul>
    </div>
    <div>
      <h5>Reference</h5>
      <ul>
        <li><a href={link('/docs')}>Help</a></li>
        <li><a href={`${link('/docs')}#methods`}>How results are calculated</a></li>
        <li><a href={`${link('/docs')}#prism`}>Prism files</a></li>
        <li><a href={`${repo}/blob/main/SPEC.md`}>Design spec</a></li>
      </ul>
    </div>
    <div>
      <h5>Project</h5>
      <ul>
        <li><a href={repo}>Source on GitHub</a></li>
        <li><a href={`${repo}/issues`}>Issues</a></li>
        <li><a href={`${repo}/blob/main/LICENSE`}>Licence</a></li>
        <li><a href={`${repo}/blob/main/THIRD_PARTY_NOTICES.md`}>Third-party notices</a></li>
        <li><a href="https://epilepsycenter.github.io/">Epilepsy Center</a></li>
      </ul>
    </div>
  </div>
  <div class="foot-rule"></div>
  <div class="foot-bot">
    <span>Epilepsy Center, Lund University · v0.1.1</span>
    <span>Built for the bench, quietly.</span>
  </div>
</div></footer>
