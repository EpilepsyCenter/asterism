# ASTERISM house style — non-negotiable export-fidelity settings (SPEC §10b).
# Everything here exists to make matplotlib output open in Affinity essentially
# final. Do not "clean up" these values without re-running the export QA.

# --- Export fidelity (the hard requirement) --------------------------------
svg.fonttype:        none      # keep text as <text>; default 'path' OUTLINES ALL TEXT
pdf.fonttype:        42        # embed TrueType; default Type 3 imports badly
ps.fonttype:         42
axes.unicode_minus:  False     # plain hyphen-minus; avoids U+2212 glyph substitution
savefig.transparent: True      # composite cleanly over panel backgrounds

# --- Typography ------------------------------------------------------------
# NEVER DejaVu Sans (the matplotlib default). Arial/Helvetica must be installed
# on any machine that OPENS these files, because svg.fonttype:none references the
# font by name rather than embedding it.
font.family:         sans-serif
font.sans-serif:     Arial, Helvetica
font.size:           7.0       # points, correct at 1:1 (journal body ~7pt)
axes.titlesize:      8.0
axes.labelsize:      7.0
xtick.labelsize:     7.0
ytick.labelsize:     7.0
legend.fontsize:     7.0

# --- Line weights (points, correct at 1:1) ---------------------------------
axes.linewidth:      0.75
xtick.major.width:   0.75
ytick.major.width:   0.75
xtick.major.size:    3.0
ytick.major.size:    3.0
lines.linewidth:     1.0

# --- Spines: publication convention (only left + bottom) -------------------
axes.spines.top:     False
axes.spines.right:   False

# --- Rasterization: off. Nothing in a figure should become pixels unless a
#     human deliberately opts in per-artist (SPEC §10b "Geometry").
image.composite_image: False

# --- Ticks -----------------------------------------------------------------
xtick.direction:     out
ytick.direction:     out
